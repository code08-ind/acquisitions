# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secure-jwt-secret-here

# Neon Cloud Database (production)
# Get this from your Neon Console: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Arcjet Security
ARCJET_KEY=your_arcjet_production_key_here
